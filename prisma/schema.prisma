generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUÁRIOS (autenticação)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("visualizador")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  dailyApprovalsCreated DailyApproval[]   @relation("DailyApprovalCreatedBy")
  dailyApprovalsUpdated DailyApproval[]   @relation("DailyApprovalUpdatedBy")
  ingressosRetirados    ReservaIngresso[] @relation("IngressoRetiradoPor")

  stockMarkersCreated StockMarker[] @relation("StockMarkerCreatedBy")

  receiptsFinalized DeliveryReceipt[] @relation("ReceiptFinalizedBy")

  eventosCriados          Evento[]         @relation("EventosCriados")
  eventosEncerrados       Evento[]         @relation("EventosEncerrados")
  operacoesEmEventos      EventoOperador[] @relation("OperacoesEmEventos")
  recebimentosRegistrados Recebimento[]    @relation("RecebimentosRegistrados")

  arrecadacoesExtra ArrecadacaoExtra[] @relation("ArrecadacaoExtraOperador")

  // ONDA 23 — PAA
  entregasPaaCriadas EntregaPaa[] @relation("EntregaPaaCreatedBy")

  // ONDA 23.7b — cota PAA
  cotaResetsCriados PaaCotaReset[] @relation("PaaCotaResetCreatedBy")
}

// ==========================================
// NEXTAUTH
// ==========================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// PRODUTOS
// ==========================================
model Product {
  id        String   @id @default(cuid())
  name      String
  category  String
  unit      String
  minStock  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ONDA 23 — PAA
  isPaa           Boolean  @default(false)
  codigoConab     Int?     @unique
  paaConvencional Decimal? @db.Decimal(10, 2)

  temOrganico         Boolean  @default(false)
  codigoConabOrganico Int?     @unique // só nos 6 casos divergentes
  paaOrganico         Decimal? @db.Decimal(10, 2)

  paaUnidade String?
  paaFatorKg Decimal @default(1) @db.Decimal(6, 3)

  donationItems     DonationItem[]
  distributionItems DistributionItem[]
  harvestItems      HarvestItem[]
  eventoAlimentos   EventoAlimento[]
  entregaPaaItens   EntregaPaaItem[]

  @@index([isPaa])
  @@index([codigoConab])
}

// ==========================================
// DOADORES
// ==========================================
model Donor {
  id        String   @id @default(cuid())
  name      String
  type      String
  category  String
  contact   String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations Donation[]

    // ONDA 23.7e-3 — visibilidade
/// Oculto da listagem geral. NULL = visível. Só dev alterna.
hiddenAt   DateTime?
hiddenById String?
hiddenNota String?

@@index([hiddenAt])


}

// ==========================================
// BENEFICIÁRIOS
// ==========================================
model Beneficiary {
  id        String   @id @default(cuid())
  name      String
  type      String
  address   String?
  phone     String?
  contact   String?
  status    String   @default("ativo")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributions Distribution[]

  // ONDA 23.7e-3 — visibilidade
/// Oculto da listagem geral. NULL = visível. Só dev alterna.
hiddenAt   DateTime?
hiddenById String?
hiddenNota String?

@@index([hiddenAt])


}

// ==========================================
// FUNCIONÁRIOS
// ==========================================
model Employee {
  id        String   @id @default(cuid())
  name      String
  role      String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donationsAsEmployee1 Donation[] @relation("DonationEmployee1")
  donationsAsEmployee2 Donation[] @relation("DonationEmployee2")
  donationsAsEmployee3 Donation[] @relation("DonationEmployee3")

  distributionsAsEmployee1 Distribution[] @relation("DistributionEmployee1")
  distributionsAsEmployee2 Distribution[] @relation("DistributionEmployee2")
  distributionsAsEmployee3 Distribution[] @relation("DistributionEmployee3")

  harvestsAsEmployee1 SolidarityHarvest[] @relation("HarvestEmployee1")
  harvestsAsEmployee2 SolidarityHarvest[] @relation("HarvestEmployee2")
  harvestsAsEmployee3 SolidarityHarvest[] @relation("HarvestEmployee3")

  // ONDA 23 — PAA
  entregasPaaAsEmployee1 EntregaPaa[] @relation("EntregaPaaEmployee1")
  entregasPaaAsEmployee2 EntregaPaa[] @relation("EntregaPaaEmployee2")

    // ONDA 23.7e-3 — visibilidade
/// Oculto da listagem geral. NULL = visível. Só dev alterna.
hiddenAt   DateTime?
hiddenById String?
hiddenNota String?

@@index([hiddenAt])


}

// ==========================================
// DOAÇÃO
// ==========================================
model Donation {
  id        String   @id @default(cuid())
  donorId   String
  date      DateTime @default(now())
  origin    String   @default("coleta")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String?
  employee   Employee? @relation("DonationEmployee1", fields: [employeeId], references: [id])

  employee2Id String?
  employee2   Employee? @relation("DonationEmployee2", fields: [employee2Id], references: [id])

  employee3Id String?
  employee3   Employee? @relation("DonationEmployee3", fields: [employee3Id], references: [id])

  donor Donor          @relation(fields: [donorId], references: [id])
  items DonationItem[]
}

model DonationItem {
  id         String  @id @default(cuid())
  donationId String
  productId  String
  quantity   Float
  boxes      Int?
  weighed    Boolean @default(false)

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// ==========================================
// DISTRIBUIÇÃO
// ==========================================
enum DistributionOrigin {
  DOACAO
  COLHEITA
  EVENTO
  PAA
}

model Distribution {
  id            String   @id @default(cuid())
  beneficiaryId String
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  status DistributionStatus @default(PENDENTE)
  legacy Boolean            @default(false)

  origem DistributionOrigin @default(DOACAO)

  employeeId  String?
  employee    Employee? @relation("DistributionEmployee1", fields: [employeeId], references: [id])
  employee2Id String?
  employee2   Employee? @relation("DistributionEmployee2", fields: [employee2Id], references: [id])
  employee3Id String?
  employee3   Employee? @relation("DistributionEmployee3", fields: [employee3Id], references: [id])

  beneficiary Beneficiary        @relation(fields: [beneficiaryId], references: [id])
  items       DistributionItem[]
  receipt     DeliveryReceipt?

  @@index([status])
  @@index([origem])
}

model DistributionItem {
  id             String @id @default(cuid())
  distributionId String
  productId      String
  quantity       Float
  boxes          Int?

  origem String @default("DOACAO")

  distribution Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
}

// ==========================================
// PRODUTORES RURAIS
// ==========================================
model Producer {
  id               String   @id @default(cuid())
  name             String
  phone            String?
  address          String?
  property         String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  atendeColheita   Boolean  @default(true)
  atendePaa        Boolean  @default(false)
  cotaOverride     Decimal? @db.Decimal(12, 2)
  cotaOverrideNota String?

  // 🆕 ONDA 23.7e-3 — soft-hide (exclusivo dev)
  hiddenAt   DateTime?
  hiddenById String?
  hiddenNota String?

  harvests    SolidarityHarvest[]
  entregasPaa EntregaPaa[]
  cotaResets  PaaCotaReset[]

  @@index([hiddenAt])
}

// ==========================================
// COLHEITA SOLIDÁRIA
// ==========================================
model SolidarityHarvest {
  id             String   @id @default(cuid())
  producerId     String
  date           DateTime @default(now())
  status         String   @default("agendada")
  notes          String?
  indemnityValue Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employeeId String?
  employee   Employee? @relation("HarvestEmployee1", fields: [employeeId], references: [id])

  employee2Id String?
  employee2   Employee? @relation("HarvestEmployee2", fields: [employee2Id], references: [id])

  employee3Id String?
  employee3   Employee? @relation("HarvestEmployee3", fields: [employee3Id], references: [id])

  producer Producer      @relation(fields: [producerId], references: [id])
  items    HarvestItem[]
}

model HarvestItem {
  id        String @id @default(cuid())
  harvestId String
  productId String
  quantity  Float
  boxes     Int?

  harvest SolidarityHarvest @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id])
}

// ============================================
// ONDA 23 — PAA (Programa de Aquisição de Alimentos)
// ============================================
enum TipoCultivoPaa {
  CONVENCIONAL
  ORGANICO
}

model EntregaPaa {
  id          String   @id @default(cuid())
  producerId  String
  dataEntrega DateTime @db.Date
  numeroNota  String?
  observacoes String?

  valorTotal  Decimal @default(0) @db.Decimal(12, 2)
  pesoTotalKg Decimal @default(0) @db.Decimal(12, 3)

  employeeId  String?
  employee    Employee? @relation("EntregaPaaEmployee1", fields: [employeeId], references: [id])
  employee2Id String?
  employee2   Employee? @relation("EntregaPaaEmployee2", fields: [employee2Id], references: [id])

  createdById String?
  createdBy   User?   @relation("EntregaPaaCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producer Producer         @relation(fields: [producerId], references: [id])
  itens    EntregaPaaItem[]

  @@index([producerId])
  @@index([dataEntrega])
  // 🚀 23.7b: cota corta o acumulado por createdAt dentro de um produtor.
  @@index([producerId, createdAt])
  @@map("entregas_paa")
}

model EntregaPaaItem {
  id           String @id @default(cuid())
  entregaPaaId String
  productId    String

  tipoCultivo TipoCultivoPaa @default(CONVENCIONAL)

  quantidade    Decimal @db.Decimal(12, 3)
  precoUnitario Decimal @db.Decimal(10, 2)
  fatorKg       Decimal @db.Decimal(6, 3)
  pesoKg        Decimal @db.Decimal(12, 3)
  subtotal      Decimal @db.Decimal(12, 2)

  entregaPaa EntregaPaa @relation(fields: [entregaPaaId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([entregaPaaId])
  @@index([productId])
  @@map("entregas_paa_itens")
}

// ============================================
// ONDA 23.7b — COTA PAA
// ============================================

/// ⚙️ Config global do PAA. Tabela de linha única, id fixo "default".
model PaaConfig {
  id String @id @default("default")

  /// Teto padrão em R$ por produtor. Todos começam com 15.000,00.
  cotaPadrao Decimal @default(15000) @db.Decimal(12, 2)

  /// % do teto que dispara o aviso de proximidade.
  alertaPercentual Int @default(80)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("paa_config")
}

/// ♻️ Marco de reset manual de cota (admin/dev).
/// Mesmo padrão de StockMarker: NÃO apaga entregas — grava um corte datado.
/// O acumulado passa a somar apenas entregas com createdAt >= resetAt.
/// producerId NULL = reset global (vale para todos os produtores).
model PaaCotaReset {
  id         String    @id @default(cuid())
  producerId String?
  producer   Producer? @relation(fields: [producerId], references: [id])

  /// Instante do corte. Compara-se com EntregaPaa.createdAt (ato de lançamento).
  resetAt DateTime @default(now())
  motivo  String

  /// 📸 Snapshot do valor zerado — prova do acumulado no momento do reset.
  valorZerado Decimal @db.Decimal(12, 2)

  createdById String
  createdBy   User   @relation("PaaCotaResetCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([producerId, resetAt])
  @@index([resetAt])
  @@map("paa_cota_resets")
}

// ==========================================
// APROVEITAMENTO DIÁRIO
// ==========================================
model DailyApproval {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  approvedQty Float
  notes       String?

  createdById String
  createdBy   User   @relation("DailyApprovalCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("DailyApprovalUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_approvals")
}

// ==========================================
// ONDA 16.2 — MARCOS DE ESTOQUE
// ==========================================
enum StockMarkerType {
  ZERO
  ADJUSTMENT
}

model StockMarker {
  id         String          @id @default(cuid())
  type       StockMarkerType
  date       DateTime // ⏱️ 23.6a-bis: instante da calibragem (era @unique @db.Date)
  quantityKg Float
  note       String?

  createdById String
  createdBy   User     @relation("StockMarkerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date]) // ⚠️ sem @unique — unicidade por dia civil validada na API
  @@index([type])
  @@map("stock_markers")
}

// ==========================================
// ONDA 16.6a — STATUS DE DISTRIBUIÇÃO
// ==========================================
enum DistributionStatus {
  PENDENTE
  ENTREGUE
}

// ==========================================
// ONDA 16.6a — COMPROVANTE DE ENTREGA
// ==========================================
model DeliveryReceipt {
  id             String       @id @default(cuid())
  distributionId String       @unique
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  recipientName String
  signatureData String  @db.Text
  notes         String? @db.Text

  finalizedById String
  finalizedBy   User     @relation("ReceiptFinalizedBy", fields: [finalizedById], references: [id])
  finalizedAt   DateTime @default(now())

  @@map("delivery_receipts")
}

// ============================================
// ONDA 17 — SISTEMA DE EVENTOS DE ARRECADAÇÃO
// ============================================
enum EventoStatus {
  RASCUNHO
  ATIVO
  ENCERRADO
}

model Evento {
  id                   String                @id @default(cuid())
  nome                 String
  descricao            String?
  dataInicio           DateTime
  dataFim              DateTime?
  status               EventoStatus          @default(RASCUNHO)
  integraEstoque       Boolean               @default(true)
  locais               LocalColeta[]
  operadores           EventoOperador[]
  recebimentos         Recebimento[]
  alimentos            EventoAlimento[]
  folhasResumoIngresso FolhaResumoIngresso[]

  arrecadacoesExtra ArrecadacaoExtra[]

  criadoPorId    String
  criadoPor      User      @relation("EventosCriados", fields: [criadoPorId], references: [id])
  encerradoPorId String?
  encerradoPor   User?     @relation("EventosEncerrados", fields: [encerradoPorId], references: [id])
  encerradoEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([criadoPorId])
  @@index([status, dataInicio])
}

model LocalColeta {
  id       String  @id @default(cuid())
  nome     String
  endereco String?

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  recebimentos Recebimento[]

  arrecadacoesExtra ArrecadacaoExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventoId])
}

model EventoAlimento {
  id String @id @default(cuid())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itensArrecadacao ArrecadacaoItem[]

  ordem        Int           @default(0)
  refugoKg     Float         @default(0)
  recebimentos Recebimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventoId, productId])
  @@index([eventoId])
  @@index([productId])
}

model EventoOperador {
  id String @id @default(cuid())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("OperacoesEmEventos", fields: [userId], references: [id])

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventoId, userId])
  @@index([userId, ativo])
}

model Recebimento {
  id String @id @default(cuid())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  localId String
  local   LocalColeta @relation(fields: [localId], references: [id])

  alimentoId String
  alimento   EventoAlimento @relation(fields: [alimentoId], references: [id])

  quantidade Float
  unidade    String

  doadorCpf String?

  operadorId String
  operador   User   @relation("RecebimentosRegistrados", fields: [operadorId], references: [id])

  createdAt DateTime @default(now())

  @@index([eventoId])
  @@index([localId])
  @@index([alimentoId])
  @@index([operadorId])
  @@index([eventoId, createdAt])
  @@index([eventoId, doadorCpf])
}

model ArrecadacaoExtra {
  id       String @id @default(cuid())
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  doadorNome String
  doadorCpf  String?

  localId String?
  local   LocalColeta? @relation(fields: [localId], references: [id])

  operadorId String
  operador   User   @relation("ArrecadacaoExtraOperador", fields: [operadorId], references: [id])

  itens ArrecadacaoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventoId])
}

model ArrecadacaoItem {
  id String @id @default(cuid())

  arrecadacaoId String
  arrecadacao   ArrecadacaoExtra @relation(fields: [arrecadacaoId], references: [id], onDelete: Cascade)

  showDia String

  alimentoId String
  alimento   EventoAlimento @relation(fields: [alimentoId], references: [id])

  quantidade   Int
  numeroInicio Int
  numeroFim    Int

  @@index([arrecadacaoId])
  @@index([showDia])
}

// ============================================
// INGRESSOS SOLIDÁRIOS
// ============================================
model LoteIngresso {
  id             String            @id @default(cuid())
  nomeArquivo    String            @unique
  operador       String?
  showData       DateTime          @db.Date
  showLabel      String
  importadoPorId String
  importadoEm    DateTime          @default(now())
  totalLinhas    Int               @default(0)
  ingressos      ReservaIngresso[]

  @@index([showData])
  @@map("lotes_ingresso")
}

model ReservaIngresso {
  id         String       @id @default(cuid())
  loteId     String
  lote       LoteIngresso @relation(fields: [loteId], references: [id], onDelete: Cascade)
  protocolo  String
  cpf        String
  nome       String
  dataNasc   String?
  cidade     String?
  bairro     String?
  retirado   Boolean      @default(false)
  retiradoEm DateTime?

  retiradoPorId String?
  retiradoPor   User?   @relation("IngressoRetiradoPor", fields: [retiradoPorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([loteId, protocolo])
  @@index([cpf])
  @@index([protocolo])
  @@map("reservas_ingresso")
}

model FolhaResumoIngresso {
  id             String   @id @default(cuid())
  eventoId       String
  codigoFamiliar String
  cpf            String
  rendaPerCapita Decimal  @db.Decimal(10, 2)
  registradoPor  String
  showDia        String?
  createdAt      DateTime @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, codigoFamiliar])
  @@index([eventoId])
  @@index([eventoId, showDia])
}

model LimiteShow {
  id       String @id @default(cuid())
  eventoId String
  showDia  String
  limite   Int    @default(0)
  usados   Int    @default(0)

  @@unique([eventoId, showDia])
  @@index([eventoId])
}

model ShowContador {
  id           String @id @default(cuid())
  eventoId     String
  showDia      String
  ultimoNumero Int    @default(0)

  @@unique([eventoId, showDia])
  @@index([eventoId])
}

// ============================================
// TROCAS AVULSAS — CPF + SHOWS (sem trava)
// ============================================
model TrocaAvulsa {
  id        String   @id @default(cuid())
  eventoId  String
  cpf       String
  nome      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shows TrocaAvulsaShow[]

  @@index([eventoId])
  @@index([cpf])
  @@index([eventoId, createdAt])
  @@map("trocas_avulsas")
}

model TrocaAvulsaShow {
  id        String      @id @default(cuid())
  trocaId   String
  troca     TrocaAvulsa @relation(fields: [trocaId], references: [id], onDelete: Cascade)
  showDia   String
  createdAt DateTime    @default(now())

  @@index([trocaId])
  @@index([showDia])
  @@map("trocas_avulsas_shows")
}

model ModuleFlag {
  module    String   @id // 'paa', 'eventos', ...
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("module_flags")
}
